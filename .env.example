# Amazon Associate Credentials
AMAZON_ASSOCIATE_ID=pablochakone-20
AMAZON_TRACKING_ID=pablochakone-20

# Optional: Add API keys for advanced features
OPENAI_API_KEY=optional-for-ai-content

# Publishing Platform Credentials (optional - enable in config.yaml)

# YouTube (NEW)
YOUTUBE_CHANNEL_ID=your-channel-id
YOUTUBE_CREDENTIALS_FILE=youtube_credentials.json
YOUTUBE_API_KEY=optional-api-key

# Instagram (NEW)
INSTAGRAM_USERNAME=your-instagram-username
INSTAGRAM_PASSWORD=your-instagram-password
# For business accounts using Graph API:
INSTAGRAM_ACCESS_TOKEN=your-access-token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your-business-account-id

# WordPress
WP_SITE_URL=https://yoursite.com
WP_USERNAME=your-username
WP_APP_PASSWORD=your-app-password

# Medium
MEDIUM_TOKEN=your-integration-token

# Ghost CMS
GHOST_API_URL=https://yoursite.com
GHOST_ADMIN_KEY=your-admin-key-id:secret

# Generic Webhook
WEBHOOK_URL=https://your-webhook-endpoint.com/publish
